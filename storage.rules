rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }
    function eventDoc(eventId) {
      return firestore.get(/databases/(default)/documents/events/$(eventId));
    }
    function isOwner(eventId) {
      return isAuthenticated() && eventDoc(eventId).data.ownerUid == request.auth.uid;
    }
    function validAudioUpload() {
      return request.resource != null &&
        request.resource.size <= 100 * 1024 * 1024 &&
        request.resource.contentType.matches('audio/.*');
    }

    match /events/{eventId}/audio/{fileName} {
      allow read: if isOwner(eventId);
      allow create, update: if isOwner(eventId) && validAudioUpload();
      allow delete: if isOwner(eventId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}